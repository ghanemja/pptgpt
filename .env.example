# pptgpt settings. Copy this file to .env (same folder) and fill in ONE of
# the three blocks below. scripts/start.sh reads .env every time it starts.
# .env is git-ignored: your key never leaves this machine.
#
# Full guide: SETUP.md → "Use your own model".

# ── Option A: a local model through Ollama (default, no key, fully offline) ──
DECKENGINE_NARRATIVE_BACKEND=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_HOST=http://127.0.0.1:11434

# ── Option B: Anthropic (Claude) ─────────────────────────────────────────────
# Sends deck text to api.anthropic.com. Used only when named on the line below;
# a key on its own does nothing, and pptgpt never falls back to it.
# Also run once: .venv/bin/pip install anthropic
# DECKENGINE_NARRATIVE_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# DECKENGINE_NARRATIVE_MODEL=claude-sonnet-4-6

# ── Option C: any OpenAI-compatible endpoint ─────────────────────────────────
# OpenAI, a company AI gateway, LM Studio, vLLM, llama.cpp server: anything
# that answers POST <base>/chat/completions.
# The base URL ends in /v1 (no /chat/completions on the end).
# DECKENGINE_NARRATIVE_BACKEND=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# Examples of OPENAI_BASE_URL:
#   LM Studio      http://127.0.0.1:1234/v1        (key: anything, e.g. lm-studio)
#   vLLM           http://127.0.0.1:8000/v1        (start pptgpt with PORT=8010)
#   Company gateway  whatever your IT gives you, ending in /v1

# ── Other settings ───────────────────────────────────────────────────────────
# PORT=8000
