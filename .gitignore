# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
env/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Build / dist
build/
dist/
*.egg
# Generated by scripts/build-netlify.mjs from frontend/ — edit frontend/, not this.
netlify-dist/

# Local runtime outputs
/tmp/
*.log

# Frontend transient
frontend/uploads/
frontend/.cache/
uploads/

# Local Netlify folder
.netlify

# Company kits hold a company's own decks, templates and images. They live on
# the machine that uses them and are never committed — except the worked
# example and the setup guide, which ship with the project.
kits/*
!kits/README.md
!kits/example-co/
kits/*/.cache/

# Reviewers people tuned and saved in the Review phase. Personal; the shipped
# personas in coaches/*.json are what the project ships.
coaches/saved/
